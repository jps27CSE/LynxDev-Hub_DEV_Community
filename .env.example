# ---- Clerk (https://dashboard.clerk.com) ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ---- TiDB Cloud (https://tidbcloud.com) ----
# Connection string: mysql://user:password@host:4000/dbname
DATABASE_URL=

# ---- Admin access (lib/admin-auth.ts) ----
# Comma-separated allowlist. Fail-closed: if BOTH are empty, nobody is an
# admin and /admin redirects to /. ADMIN_CLERK_IDS is the fast path and skips
# the users-table lookup entirely, so prefer it.
ADMIN_EMAILS=
ADMIN_CLERK_IDS=

# ---- Feature flags ----
# AI Mentor chat. Anything other than exactly "true" is treated as disabled.
MENTOR_ENABLED=true

# Global site notice (Admin > Site Notice). Set to "true" to suppress the
# notice for ALL users regardless of the database setting — the bail-out for
# when admin access is lost. Case-insensitive. Requires a redeploy to change.
SITE_NOTICE_DISABLED=false

# ---- Cron (vercel.json) ----
# Bearer token required by /api/cron/cleanup. Generate with: openssl rand -hex 32
CRON_SECRET=

# ---- Mistral AI (https://console.mistral.ai) ----
MISTRAL_API_KEY=

# ---- YouTube (https://www.youtube.com) ----
# Playlist for homepage carousel (RSS, no API key needed)
# Get your playlist ID from: https://www.youtube.com/playlist?list=YOUR_PLAYLIST_ID
# YOUTUBE_PLAYLIST_ID=PLxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Channel fallback used by lib/youtube.ts when no playlist ID is set
# YOUTUBE_CHANNEL_ID=
